# ---------- 链配置 ----------
# Robinhood Chain: mainnet 4663 / testnet 46630; BSC 预留: 56 / 97
RPC_URL_4663=https://rpc.robinhood.com            # TODO: 确认官方 RPC
RPC_URL_46630=https://rpc.testnet.robinhood.com   # TODO: 确认
RPC_URL_56=https://bsc-dataseed.binance.org       # 预留,暂未启用
ENABLED_CHAINS=4663                                # 逗号分隔

# ---------- snowon.fun 合约(Robinhood Chain) ----------
# TODO: 部署后填入实际地址
SNOWON_FACTORY_4663=0x0000000000000000000000000000000000000000
SNOWON_HOOK_4663=0x0000000000000000000000000000000000000000
SNOWON_REGISTRY_4663=0x0000000000000000000000000000000000000000
SNOWON_SWAP_ROUTER_4663=0x0000000000000000000000000000000000000000
SNOWON_POOL_MANAGER_4663=0x0000000000000000000000000000000000000000
SNOWON_DEPLOY_BLOCK_4663=0

# ---------- 数据层 ----------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/terminal
REDIS_URL=redis://localhost:6379

# ---------- 聊天服务 ----------
CHAT_WS_PORT=8080

# ---------- Web ----------
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_WS_URL=ws://localhost:8080
# 前后端分离:前端(Vercel)构建时填后端地址,浏览器直连;留空=同源(本地/一体机)
NEXT_PUBLIC_API_BASE=                             # 例:https://api.snowon.fun
# 后端(EC2)放行的前端来源,逗号分隔,或 *(仅 GET 无凭证时可用)
CORS_ALLOW_ORIGIN=                                # 例:https://your-app.vercel.app
NEXT_PUBLIC_PRIVY_APP_ID=                        # privy.io 申请
# Privy 服务端校验
PRIVY_APP_SECRET=

# 代币页「分析」Tab:配了则用 xAI 写结论(服务端,不要 NEXT_PUBLIC)
# https://console.x.ai
XAI_API_KEY=
