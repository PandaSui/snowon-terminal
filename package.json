{
  "name": "snowon-terminal",
  "private": true,
  "version": "0.1.0",
  "description": "Aggregated trading terminal for launchpad tokens (snowon.fun first), pre/post graduation",
  "scripts": {
    "dev": "node tools/dev-web.mjs",
    "services": "node tools/start-services.mjs",
    "dev:web": "pnpm --filter web dev",
    "dev:indexer": "pnpm --filter indexer dev",
    "dev:chat": "pnpm --filter chat dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @terminal/db db:generate",
    "db:migrate": "pnpm --filter @terminal/db db:migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
